# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Where reset / confirm / order links in emails point.
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tbvault
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672

# JWT signing secrets: long random strings, different from each other.
ACCESS_TOKEN=
REFRESH_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=tbvault
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Used by `npm run seed`. An existing account with this email is promoted to ADMIN.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
