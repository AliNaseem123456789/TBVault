# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Where reset / confirm / order links in emails point.
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tbvault
# AWS RDS: DATABASE_URL=postgresql://USER:PASSWORD@xxxx.ap-south-1.rds.amazonaws.com:5432/tbvault?sslmode=require
# plus the RDS CA bundle (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem):
# DB_SSL_CA_FILE=./certs/rds-global-bundle.pem
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672

# JWT signing secrets: long random strings, different from each other.
ACCESS_TOKEN=
REFRESH_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Card payments (Stripe). Leave empty to offer cash on delivery only.
# Test keys: https://dashboard.stripe.com/test/apikeys
# Webhook secret for local development: `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Product images (S3). For AWS leave S3_ENDPOINT empty; for local MinIO set it to http://localhost:9000.
S3_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Used by `npm run seed`. An existing account with this email is promoted to ADMIN.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Integration tests (npm run test:integration): a throwaway, migrated database. It is wiped on every run.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tbvault_test

# AI shopping assistant (the Python service in chatbot/). Optional: without it the
# rest of the shop works and /api/chat answers 503.
CHATBOT_URL=http://localhost:8000
# Same value as CHATBOT_INTERNAL_KEY in chatbot/.env (leave both empty locally if you like)
CHATBOT_INTERNAL_KEY=
