// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
// ==============================
// USERS
// ==============================
model Session {
  id                 Int       @id @default(autoincrement())
  user_id            Int

  refresh_token_hash String
  jti                String    @unique

  expires_at         DateTime
  revoked_at         DateTime?

  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  user_agent         String?   @db.Text
  ip_address         String?   @db.VarChar(45)
  device_name        String?

  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model PasswordResetToken {
  id          Int       @id @default(autoincrement())
  user_id     Int

  token_hash  String    @unique

  expires_at  DateTime
  used_at     DateTime?

  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id          Int       @id @default(autoincrement())
  user_id     Int

  token_hash  String    @unique

  expires_at  DateTime
  used_at     DateTime?

  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("email_verification_tokens")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}
model User {
  id          Int      @id @default(autoincrement())
  name        String?  @db.VarChar(50)
  email       String   @unique @db.VarChar(255)
  password    String?  @db.VarChar(255)   // ← changed from required to optional
  is_verified Boolean  @default(false)
  role        UserRole @default(CUSTOMER)
  is_blocked  Boolean  @default(false)
  blocked_at  DateTime?
  credit_balance Decimal @default(0) @db.Decimal(10, 2)   // store credit; changes only alongside a credit_transactions row
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  seller                     Seller?
  credit_transactions        CreditTransaction[]
  credit_topups              CreditTopup[]
  gift_cards_redeemed        GiftCard[] @relation("GiftCardRedeemer")
  cart                       Cart?
  orders                     Order[]
  sessions                   Session[]
  password_reset_tokens      PasswordResetToken[]
  email_verification_tokens  EmailVerificationToken[]
  oauth_accounts              OAuthAccount[]
  reviews                     Review[]
  addresses                   Address[]
  wishlist_items              WishlistItem[]
  coupon_redemptions          CouponRedemption[]
  return_requests             ReturnRequest[]
  stock_notifications         StockNotification[]
  @@map("users")
}
model OAuthAccount {
  id                Int      @id @default(autoincrement())
  user_id           Int

  provider          String   @db.VarChar(50)   // "google", later "github" etc.
  provider_user_id  String   @db.VarChar(255)  // Google's `sub` claim

  created_at        DateTime @default(now())

  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([user_id])
  @@map("oauth_accounts")
}
// ==============================
// PRODUCTS
// ==============================
model Category {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(100)
  created_at DateTime  @default(now())

  products   Product[]
  sales      Sale[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  is_hidden   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  category_id Int
  category    Category  @relation(fields: [category_id], references: [id])
  brand_id    Int?
  brand       Brand?    @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  seller_id   Int                                   // the store's own products belong to the platform seller
  seller      Seller    @relation(fields: [seller_id], references: [id])

  reviews             Review[]
  images              ProductImage[]
  variants            ProductVariant[]
  cart_items          CartItem[]
  order_items         OrderItem[]
  sales               Sale[]
  wishlist_items      WishlistItem[]
  stock_notifications StockNotification[]

  @@index([category_id])
  @@index([brand_id])
  @@index([seller_id])
  @@index([name])
  @@index([price])
  @@index([created_at])
  @@map("products")
}

// A purchasable option of a product (e.g. "Black / M"). When a product has active
// variants, price and stock come from the variant instead of the product.
model ProductVariant {
  id         Int      @id @default(autoincrement())
  product_id Int
  name       String   @db.VarChar(100)          // "Black / M", shown to customers
  sku        String?  @unique @db.VarChar(64)
  options    Json?                               // { "Color": "Black", "Size": "M" }
  price      Decimal? @db.Decimal(10, 2)         // null = same as the product
  stock      Int      @default(0)
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product             Product             @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cart_items          CartItem[]
  order_items         OrderItem[]
  stock_notifications StockNotification[]

  @@index([product_id])
  @@map("product_variants")
}

model ProductImage {
  id            Int      @id @default(autoincrement())
  product_id    Int
  key           String
  original_name String?
  mime_type     String?
  size          Int?
  is_primary    Boolean  @default(false)

  created_at    DateTime @default(now())

  product       Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  @@index([product_id])
  @@map("product_images")
}

model Review {
  id         Int      @id @default(autoincrement())
  product_id Int
  user_id    Int
  rating     Int      // 1-5, validated in reviews.controller.js
  comment    String?  @db.Text
  is_hidden  Boolean  @default(false)   // hidden by an admin (moderation)
  moderated_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([product_id, user_id])   // one review per user per product
  @@index([product_id])
  @@index([user_id])
  @@map("reviews")
}

// A timed percentage discount on one product or a whole category.
model Sale {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  percent_off Int                              // 1-90
  product_id  Int?
  category_id Int?
  starts_at   DateTime
  ends_at     DateTime
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  product     Product?  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([category_id])
  @@index([starts_at, ends_at])
  @@map("sales")
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@map("wishlist_items")
}

// "Email me when it's back in stock."
model StockNotification {
  id          Int       @id @default(autoincrement())
  product_id  Int
  variant_id  Int?
  user_id     Int?
  email       String    @db.VarChar(255)
  notified_at DateTime?
  created_at  DateTime  @default(now())

  product     Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([product_id, variant_id])
  @@map("stock_notifications")
}

// ==============================
// CART
// ==============================
model Cart {
  id          Int      @id @default(autoincrement())
  user_id     Int      @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relationships
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items       CartItem[]

  @@map("cart")
}

model CartItem {
  id          Int      @id @default(autoincrement())
  cart_id     Int
  product_id  Int
  variant_id  Int?
  quantity    Int      @default(1)
  created_at  DateTime @default(now())

  // Relationships
  cart        Cart            @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([cart_id, product_id])
  @@map("cart_items")
}

// ==============================
// CUSTOMERS
// ==============================
model Address {
  id          Int      @id @default(autoincrement())
  user_id     Int
  label       String?  @db.VarChar(50)     // "Home", "Office"
  full_name   String   @db.VarChar(100)
  phone       String   @db.VarChar(30)
  line1       String   @db.VarChar(200)
  line2       String?  @db.VarChar(200)
  city        String   @db.VarChar(100)
  state       String?  @db.VarChar(100)
  postal_code String?  @db.VarChar(20)
  country     String   @db.VarChar(100)
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("addresses")
}

// ==============================
// STORE SETTINGS
// ==============================
// Simple key/value settings (tax rate, low-stock threshold, alert email...).
// Defaults live in src/services/settings/settings.service.js.
model Setting {
  key        String   @id @db.VarChar(64)
  value      String   @db.Text
  updated_at DateTime @updatedAt

  @@map("settings")
}

// Shipping price by region. An address matches a zone when its city, state or
// country is in `regions`; otherwise the default zone applies.
model ShippingZone {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  regions    String[]                          // lower-case city / state / country names
  rate       Decimal  @db.Decimal(10, 2)
  free_over  Decimal? @db.Decimal(10, 2)       // free shipping when the discounted subtotal reaches this
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("shipping_zones")
}

// ==============================
// COUPONS
// ==============================
enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id               Int        @id @default(autoincrement())
  code             String     @unique @db.VarChar(40)   // stored upper-case
  description      String?    @db.VarChar(255)
  type             CouponType
  value            Decimal    @default(0) @db.Decimal(10, 2)  // percent (1-100) or amount
  max_discount     Decimal?   @db.Decimal(10, 2)        // cap for PERCENT coupons
  min_order_amount Decimal?   @db.Decimal(10, 2)
  starts_at        DateTime?
  expires_at       DateTime?
  usage_limit      Int?                                  // total uses, null = unlimited
  per_user_limit   Int?                                  // per customer (account or guest email)
  times_used       Int        @default(0)
  is_active        Boolean    @default(true)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  redemptions      CouponRedemption[]
  orders           Order[]

  @@map("coupons")
}

model CouponRedemption {
  id              Int      @id @default(autoincrement())
  coupon_id       Int
  order_id        Int      @unique
  user_id         Int?
  email           String   @db.VarChar(255)
  discount_amount Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now())

  coupon          Coupon   @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([coupon_id, email])
  @@map("coupon_redemptions")
}

// ==============================
// ORDERS
// ==============================
model Order {
  id               Int      @id @default(autoincrement())
  user_id          Int?                                   // null for guest orders
  guest_email      String?  @db.VarChar(255)
  public_token     String   @unique @db.VarChar(64)       // lets guests track their order without an account
  order_date       DateTime @default(now())
  status           String   @default("pending") @db.VarChar(20)

  subtotal         Decimal  @default(0) @db.Decimal(10, 2)
  discount_total   Decimal  @default(0) @db.Decimal(10, 2)
  shipping_total   Decimal  @default(0) @db.Decimal(10, 2)
  tax_total        Decimal  @default(0) @db.Decimal(10, 2)
  total_amount     Decimal  @db.Decimal(10, 2)
  coupon_id        Int?
  coupon_code      String?  @db.VarChar(40)
  credits_applied  Decimal  @default(0) @db.Decimal(10, 2)   // part of total_amount paid with store credit

  payment_method   String   @default("cod") @db.VarChar(20)     // cod | card
  payment_status   String   @default("unpaid") @db.VarChar(20)  // unpaid | paid | partially_refunded | refunded
  paid_at          DateTime?
  amount_refunded  Decimal  @default(0) @db.Decimal(10, 2)
  stripe_checkout_session_id String? @unique @db.VarChar(255)
  stripe_payment_intent_id   String? @db.VarChar(255)

  shipping_address String?  @db.Text
  tracking_carrier String?  @db.VarChar(100)
  tracking_number  String?  @db.VarChar(100)
  tracking_url     String?  @db.VarChar(500)
  shipped_at       DateTime?
  delivered_at     DateTime?
  cancelled_at     DateTime?

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Relationships
  user               User?               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  coupon             Coupon?             @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  items              OrderItem[]
  status_history     OrderStatusHistory[]
  coupon_redemption  CouponRedemption?
  refunds            Refund[]
  return_requests    ReturnRequest[]
  seller_orders      SellerOrder[]
  credit_transactions CreditTransaction[]

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  order_id     Int
  product_id   Int
  variant_id   Int?
  seller_order_id Int?                  // which seller ships this item
  product_name String?  @db.VarChar(100)   // snapshot at purchase time
  variant_name String?  @db.VarChar(100)
  quantity     Int
  unit_price   Decimal  @db.Decimal(10, 2)  // price actually charged per unit (after sales)
  list_price   Decimal? @db.Decimal(10, 2)  // price before any sale
  total_price  Decimal  @db.Decimal(10, 2)
  created_at   DateTime @default(now())

  // Relationships
  order        Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)
  seller_order SellerOrder?    @relation(fields: [seller_order_id], references: [id], onDelete: SetNull)
  return_items ReturnItem[]

  @@index([seller_order_id])

  @@map("order_items")
}

// Every status change, who made it and when. The customer's tracking timeline is built from this.
model OrderStatusHistory {
  id            Int      @id @default(autoincrement())
  order_id      Int
  from_status   String?  @db.VarChar(20)
  to_status     String   @db.VarChar(20)
  note          String?  @db.VarChar(500)
  actor_type    String   @db.VarChar(20)   // customer | admin | system | payment
  actor_user_id Int?
  created_at    DateTime @default(now())

  order         Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_status_history")
}

// ==============================
// PAYMENTS
// ==============================
model Refund {
  id               Int      @id @default(autoincrement())
  order_id         Int
  return_id        Int?
  amount           Decimal  @db.Decimal(10, 2)
  reason           String?  @db.VarChar(500)
  method           String   @db.VarChar(20)    // stripe | manual
  stripe_refund_id String?  @unique @db.VarChar(255)
  status           String   @db.VarChar(20)    // pending | succeeded | failed
  created_by       Int?
  created_at       DateTime @default(now())

  order            Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  return_request   ReturnRequest? @relation(fields: [return_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@map("refunds")
}

// Stripe webhook events already handled, so a redelivered event is ignored.
model PaymentEvent {
  id         String   @id @db.VarChar(255)   // Stripe event id
  type       String   @db.VarChar(100)
  created_at DateTime @default(now())

  @@map("payment_events")
}

// ==============================
// RETURNS
// ==============================
enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id            Int          @id @default(autoincrement())
  order_id      Int
  user_id       Int?
  status        ReturnStatus @default(REQUESTED)
  reason        String       @db.Text
  admin_note    String?      @db.Text
  refund_amount Decimal?     @db.Decimal(10, 2)
  restocked     Boolean      @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  order         Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  items         ReturnItem[]
  refunds       Refund[]

  @@index([order_id])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id            Int           @id @default(autoincrement())
  return_id     Int
  order_item_id Int
  quantity      Int

  return_request ReturnRequest @relation(fields: [return_id], references: [id], onDelete: Cascade)
  order_item     OrderItem     @relation(fields: [order_item_id], references: [id], onDelete: Cascade)

  @@index([return_id])
  @@map("return_items")
}

// ==============================
// ANALYTICS
// ==============================
// One row per browser session per day, for the dashboard's conversion rate.
model SiteVisit {
  id         Int      @id @default(autoincrement())
  visitor_id String   @db.VarChar(64)   // random id kept in the browser, not personal data
  day        DateTime @db.Date
  created_at DateTime @default(now())

  @@unique([visitor_id, day])
  @@index([day])
  @@map("site_visits")
}

// ==============================
// MARKETPLACE
// ==============================

model Brand {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(100)
  created_at DateTime  @default(now())

  products   Product[]

  @@map("brands")
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// A store on the marketplace. The platform's own catalogue is the seller with is_platform = true.
model Seller {
  id              Int          @id @default(autoincrement())
  user_id         Int?         @unique
  store_name      String       @unique @db.VarChar(100)
  slug            String       @unique @db.VarChar(120)
  description     String?      @db.Text
  status          SellerStatus @default(PENDING)
  is_platform     Boolean      @default(false)
  commission_rate Decimal?     @db.Decimal(5, 2)   // percent; null = the store-wide commission_rate setting
  admin_note      String?      @db.VarChar(500)
  approved_at     DateTime?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  user            User?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  products        Product[]
  seller_orders   SellerOrder[]
  transactions    SellerTransaction[]
  payouts         SellerPayout[]

  @@index([status])
  @@map("sellers")
}

// One seller's share of an order: their items, their shipment, their earnings.
model SellerOrder {
  id                   Int       @id @default(autoincrement())
  order_id             Int
  seller_id            Int
  status               String    @default("pending") @db.VarChar(20)
  subtotal             Decimal   @db.Decimal(10, 2)   // this seller's items at the price charged
  commission_rate      Decimal   @db.Decimal(5, 2)
  commission_amount    Decimal   @db.Decimal(10, 2)
  seller_earnings      Decimal   @db.Decimal(10, 2)   // subtotal - commission
  earnings_credited_at DateTime?                      // set when earnings reach the seller's balance
  tracking_carrier     String?   @db.VarChar(100)
  tracking_number      String?   @db.VarChar(100)
  tracking_url         String?   @db.VarChar(500)
  shipped_at           DateTime?
  delivered_at         DateTime?
  cancelled_at         DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  order                Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  seller               Seller    @relation(fields: [seller_id], references: [id])
  items                OrderItem[]
  transactions         SellerTransaction[]

  @@unique([order_id, seller_id])
  @@index([seller_id, status])
  @@map("seller_orders")
}

// Seller balance ledger. The balance is the sum of amount.
model SellerTransaction {
  id              Int          @id @default(autoincrement())
  seller_id       Int
  type            String       @db.VarChar(20)   // earning | refund | payout | adjustment
  amount          Decimal      @db.Decimal(10, 2) // positive adds to the balance, negative takes away
  seller_order_id Int?
  payout_id       Int?
  note            String?      @db.VarChar(500)
  created_by      Int?
  created_at      DateTime     @default(now())

  seller          Seller       @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  seller_order    SellerOrder? @relation(fields: [seller_order_id], references: [id], onDelete: SetNull)
  payout          SellerPayout? @relation(fields: [payout_id], references: [id], onDelete: SetNull)

  @@index([seller_id, created_at])
  @@map("seller_transactions")
}

// Money sent to a seller outside the site (bank transfer etc.), recorded by an admin.
model SellerPayout {
  id           Int      @id @default(autoincrement())
  seller_id    Int
  amount       Decimal  @db.Decimal(10, 2)
  reference    String?  @db.VarChar(255)
  note         String?  @db.VarChar(500)
  created_by   Int?
  created_at   DateTime @default(now())

  seller       Seller   @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  transactions SellerTransaction[]

  @@index([seller_id])
  @@map("seller_payouts")
}

// ==============================
// STORE CREDIT (WALLET)
// ==============================

// Every change to users.credit_balance, with the balance after it.
model CreditTransaction {
  id            Int          @id @default(autoincrement())
  user_id       Int
  amount        Decimal      @db.Decimal(10, 2)   // positive adds credit, negative spends it
  balance_after Decimal      @db.Decimal(10, 2)
  type          String       @db.VarChar(20)      // topup | refund | admin_grant | admin_deduct | gift_card | order_payment | order_cancel
  order_id      Int?
  gift_card_id  Int?
  topup_id      Int?
  note          String?      @db.VarChar(500)
  created_by    Int?
  created_at    DateTime     @default(now())

  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order         Order?       @relation(fields: [order_id], references: [id], onDelete: SetNull)
  gift_card     GiftCard?    @relation(fields: [gift_card_id], references: [id], onDelete: SetNull)
  topup         CreditTopup? @relation(fields: [topup_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([order_id])
  @@map("credit_transactions")
}

// Buying credit by card through Stripe Checkout.
model CreditTopup {
  id                         Int       @id @default(autoincrement())
  user_id                    Int
  amount                     Decimal   @db.Decimal(10, 2)
  status                     String    @default("pending") @db.VarChar(20)   // pending | paid | expired
  stripe_checkout_session_id String?   @unique @db.VarChar(255)
  paid_at                    DateTime?
  created_at                 DateTime  @default(now())

  user                       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions               CreditTransaction[]

  @@index([user_id])
  @@map("credit_topups")
}

// Single-use code worth a fixed amount of credit.
model GiftCard {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(40)
  amount       Decimal   @db.Decimal(10, 2)
  is_active    Boolean   @default(true)
  expires_at   DateTime?
  note         String?   @db.VarChar(255)
  redeemed_by  Int?
  redeemed_at  DateTime?
  created_by   Int?
  created_at   DateTime  @default(now())

  redeemer     User?     @relation("GiftCardRedeemer", fields: [redeemed_by], references: [id], onDelete: SetNull)
  transactions CreditTransaction[]

  @@map("gift_cards")
}
