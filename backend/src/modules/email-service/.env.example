# Copy to .env and fill in. Never commit .env.
RABBITMQ_URL=amqp://localhost:5672

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "TBVault <no-reply@yourdomain.com>". Defaults to SMTP_USER.
SMTP_FROM=

# Failed sends are retried this many times, this far apart, then moved to email.jobs.dlq.
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_DELAY_MS=10000
