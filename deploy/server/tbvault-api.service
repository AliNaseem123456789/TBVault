[Unit]
Description=TBVault API
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service
# RabbitMQ may be local or hosted (CloudAMQP); the API connects to it in the background.

[Service]
User=tbvault
WorkingDirectory=/srv/tbvault/current/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --max-old-space-size=320 server.js
Restart=always
RestartSec=3
# Keep restarting after crashes instead of giving up.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
