[Unit]
Description=TBVault API
After=network-online.target redis-server.service rabbitmq-server.service
Wants=network-online.target redis-server.service rabbitmq-server.service

[Service]
User=tbvault
WorkingDirectory=/srv/tbvault/current/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --max-old-space-size=320 server.js
Restart=always
RestartSec=3
# RabbitMQ can take a few seconds after boot; keep retrying instead of giving up.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
