    {"type": "paraphrase", "query": "stick for taking photos of myself", "expect": ["Selfie Stick", "Monopod"]},
    {"type": "paraphrase", "query": "tool to flip food in a pan", "expect": ["Turner", "Spatula"]},
    {"type": "paraphrase", "query": "something to cut vegetables on", "expect": ["Chopping Board"]},
