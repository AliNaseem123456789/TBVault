# Copy to chatbot/.env and fill in. Never commit .env.
#
# DATABASE_URL, DB_SSL_CA_FILE, S3_* and RABBITMQ_URL are read from backend/.env
# automatically. Only set them here if the chatbot should use different values.

# --- required ---
PINECONE_API_KEY=your-pinecone-api-key

# --- optional: without it, search works and answers use a simple template ---
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL=openai/gpt-oss-20b     # faster and cheaper

# --- Pinecone indexes (free plan: aws / us-east-1) ---
PINECONE_TEXT_INDEX=tbvault-products
PINECONE_IMAGE_INDEX=tbvault-images
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- retrieval tuning ---
HYBRID_ALPHA=0.5          # 1 = meaning only, 0 = keywords only; tune with `python -m app.cli eval`
SEARCH_CANDIDATES=40      # hits taken from Pinecone before checking Postgres
MIN_SCORE_RATIO=0.4       # drop hits scoring below 40% of the best hit
IMAGE_MIN_SCORE_RATIO=0.8 # same for photo search (CLIP scores sit close together)
IMAGES_PER_PRODUCT=3
INDEX_VERSION=v1          # bump when you change models/text format, then reindex

# --- shared secret with the Node backend (set the same value as CHATBOT_INTERNAL_KEY in backend/.env) ---
CHATBOT_INTERNAL_KEY=
